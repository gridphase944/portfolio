# Keep repository metadata and local agent/editor state out of the context
.git/
**/.git/
.codex/
**/.codex/
.agents/
**/.agents/
.vscode/
**/.vscode/
.idea/
**/.idea/

# Credentials and local configuration at any depth
**/.env
**/.env.*
**/.ssh/
**/.aws/
**/.azure/
**/.docker/
**/.config/gcloud/
**/credentials/
**/secrets/
**/auth.json
**/credentials.json
**/credentials*.json
**/secrets*.json
**/tokens*.json
**/api_key*.json
**/cookies.txt
**/cookies.json
**/session.json
**/id_rsa
**/id_ed25519
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.token
**/*.local.json
**/*.local.yaml
**/*.local.yml
**/*.local.toml
**/*.local.ini

# Datasets and artifacts are supplied/generated outside the image
outputs/
**/outputs/
data/
**/data/
csv/
**/csv/
**/raw/
**/processed/
**/datasets/
**/*.csv
**/*.csv.gz
**/*.parquet
**/*.arrow
**/*.feather
**/*.npy
**/*.npz
**/weights/
**/checkpoints/
**/replay/
**/replay_buffers/
**/tensorboard/
**/runs/
**/*.h5
**/*.hdf5
**/*.pt
**/*.pth
**/*.pkl
**/*.pickle
**/*.ckpt
**/*.ckpt.*
**/*.keras
**/*.onnx
**/*.safetensors
**/*.data-*-of-*
**/*.index
**/events.out.tfevents*

# Caches, environments, logs and generated temporary files
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
**/.venv/
**/venv/
**/.coverage
**/.coverage.*
**/htmlcov/
**/*.egg-info/
**/build/
**/dist/
**/*.log
**/*.jsonl
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/tmp/
**/temp/
