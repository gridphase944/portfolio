{
  "learning_rate": 0.0005,
  "epochs": 100,
  "batch_size": 32,
  "model_params": {
    "cnn_filters": [128, 256],
    "rnn_units": [256, 128],
    "dropout": 0.5
  },
  "random_params":{
    "rotation": 5.0
  },
  "augmentation_params": {
    "brightness_delta": 0.2,
    "contrast_lower": 0.8,
    "contrast_upper": 1.2,
    "noise_stddev": 0.05,
    
    "perspective_prob": 0.2,
    "perspective_shear": 0.05,
    "blur_prob": 0.05,
    "cutout_prob": 0.1,
    "cutout_size_min": 0.1,
    "cutout_size_max": 0.3,

    "bg_pastel_prob": 0.5,             
    "bg_pastel_saturation_range": [10, 50],
    "bg_pastel_value_range": [230, 255]
  },
  "image_processing":{
    "scale_max": 1.2,
    "scale_min": 0.75
  },
  "L2": 0.001
}